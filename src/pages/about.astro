---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import portrait from '../images/portrait.png';
---

<Layout title="About | Evan Watanabe">


  <main class="w-full max-w-7xl mx-auto px-6 pt-28 md:pt-32 pb-20 min-h-screen flex flex-col">
    <!-- Top Hero Section -->
    <div class="w-full max-w-4xl flex flex-row gap-6 lg:gap-12 items-start md:items-stretch mx-auto mb-20">
      
      <!-- Left Column: Text + Buttons -->
      <div class="flex flex-col items-start text-left flex-1">
        <div class="scroll-reveal delay-0 flex flex-col items-start mb-6">
          <h1 class="text-white font-sans font-extrabold leading-[0.9] tracking-tight" style="font-size: clamp(2rem, 7.5vw, 6rem);">
            Evan Watanabe
          </h1>
        </div>

        <div class="scroll-reveal delay-150 mb-4 flex flex-col items-start">
          <p class="text-white/60 font-sans text-lg md:text-xl leading-relaxed max-w-lg">
            NYC-based Content Creator and Social Media &amp; Content Manager at Last Crumb. NYU Media, Culture, and Communication graduate specializing in high-growth social video.
          </p>
        </div>

        <div class="scroll-reveal delay-300 flex flex-wrap items-center justify-center md:justify-start gap-4 mt-8">
          <a href="/resume.pdf" class="inline-flex items-center justify-center gap-2 h-12 px-6 md:h-14 md:px-8 rounded-full bg-white text-black text-sm font-black tracking-tight hover:bg-white/90 hover:-translate-y-1 hover:shadow-[0_10px_30px_rgba(255,255,255,0.1)] transition-all duration-300 ease-out w-max">
            Resume
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
            </svg>
          </a>
          <a href="https://linkedin.com/in/evan-watanabe" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 h-12 px-6 md:h-14 md:px-8 rounded-full bg-transparent border-2 border-white/20 text-white text-sm font-black tracking-tight hover:border-white hover:bg-white/5 hover:-translate-y-1 transition-all duration-300 ease-out w-max">
            LinkedIn
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Right Column: Photo (4:5, bottom-aligned with buttons) -->
      <div class="scroll-reveal delay-0 w-28 sm:w-40 md:w-64 aspect-[4/5] md:aspect-auto shrink-0 rounded-[1.5rem] md:rounded-[2rem] overflow-hidden bg-[#111] border border-zinc-800">
        <Image src={portrait} alt="Portrait of Evan Watanabe" class="w-full h-full object-cover opacity-80" />
      </div>
    </div>

    <!-- Centered Experience Section -->
    <div class="w-full max-w-3xl mx-auto flex flex-col gap-10 font-sans scroll-reveal delay-300">
      
      <!-- Last Crumb -->
      <div class="border-t border-zinc-800/40 pt-6">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-2 mb-4">
          <div class="flex flex-wrap items-baseline gap-x-2">
            <span class="text-white font-bold text-lg md:text-xl">Last Crumb</span>
            <span class="text-white/40 font-medium text-sm md:text-base tracking-tight">| Social Media & Content Manager</span>
          </div>
          <span class="text-zinc-500 text-[10px] md:text-xs font-normal uppercase tracking-widest whitespace-nowrap">(2026 – Present)</span>
        </div>
        <ul class="flex flex-col gap-2 text-white/60 text-base leading-relaxed list-disc pl-5">
          <li>Create and manage all content from start to finish.</li>
          <li>Scaled presence to 186k followers.</li>
        </ul>
      </div>
      
      <!-- Pixa -->
      <div class="border-t border-zinc-800/40 pt-6">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-2 mb-4">
          <div class="flex flex-wrap items-baseline gap-x-2">
            <span class="text-white font-bold text-lg md:text-xl">Pixa (Pixelcut)</span>
            <span class="text-white/40 font-medium text-sm md:text-base tracking-tight">| Paid Ad Content Creator</span>
          </div>
          <span class="text-zinc-500 text-[10px] md:text-xs font-normal uppercase tracking-widest whitespace-nowrap">(2025 – 2026)</span>
        </div>
        <ul class="flex flex-col gap-2 text-white/60 text-base leading-relaxed list-disc pl-5">
          <li>Produced end-to-end paid ad campaigns driving rapid app downloads and user acquisition.</li>
          <li>Scaled Instagram presence to 281k followers.</li>
          <li>Leveraged AI-driven tools to optimize creative production workflows.</li>
        </ul>
      </div>

      <!-- S'more -->
      <div class="border-t border-zinc-800/40 pt-6">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-2 mb-4">
          <div class="flex flex-wrap items-baseline gap-x-2">
            <span class="text-white font-bold text-lg md:text-xl">S'more</span>
            <span class="text-white/40 font-medium text-sm md:text-base tracking-tight">| Social Media Specialist</span>
          </div>
          <span class="text-zinc-500 text-[10px] md:text-xs font-normal uppercase tracking-widest whitespace-nowrap">(2023 – 2025)</span>
        </div>
        <ul class="flex flex-col gap-2 text-white/60 text-base leading-relaxed list-disc pl-5">
          <li>Grew Instagram from 300 to 94k followers.</li>
          <li>Drove 100k+ app downloads and produced ads with 6.8M+ views.</li>
        </ul>
      </div>
      
      <!-- NYU -->
      <div class="border-t border-zinc-800/40 pt-6">
        <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-2 mb-4">
          <div class="flex flex-wrap items-baseline gap-x-2">
            <span class="text-white font-bold text-lg md:text-xl">NYU</span>
            <span class="text-white/40 font-medium text-sm md:text-base tracking-tight">| Social Media Assistant</span>
          </div>
          <span class="text-zinc-500 text-[10px] md:text-xs font-normal uppercase tracking-widest whitespace-nowrap">(2022 – 2023)</span>
        </div>
        <ul class="flex flex-col gap-2 text-white/60 text-base leading-relaxed list-disc pl-5">
          <li>Produced content for channels with 500k+ followers.</li>
          <li>Grew TikTok presence to 50k+ followers.</li>
        </ul>
      </div>
      
    </div>



  </main>
</Layout>
