---
import Layout from '../layouts/Layout.astro';
import VideoCard from '../components/VideoCard.astro';
---

<Layout title="evanwatanabe.com">
  <main class="w-full max-w-7xl mx-auto px-6 pt-32 pb-32 flex flex-col">
    <!-- Asymmetrical Flow Header (with Scroll Reveal) -->
    <header class="flex flex-col gap-12 w-full max-w-5xl mb-[clamp(6rem,12vh,10rem)] scroll-reveal">
      <div class="flex flex-col gap-4">
        <span class="text-white/40 font-sans font-bold uppercase tracking-widest text-[10px] md:text-xs">NYC-Based</span>
        <h1 class="text-white font-sans font-extrabold leading-[0.9] tracking-tight flex flex-col" style="font-size: clamp(2rem, 7.5vw, 6rem);">
          <span>Content Creator</span>
          <span class="font-sans italic font-normal tracking-tight">& Social Media Manager</span>
        </h1>
      </div>
      
      <div class="flex flex-wrap items-center gap-4">
        <a href="/contact" class="inline-flex items-center justify-center gap-2 h-12 px-6 md:h-14 md:px-8 rounded-full bg-white text-black text-sm font-black tracking-tight hover:bg-white/90 hover:-translate-y-1 hover:shadow-[0_10px_30px_rgba(255,255,255,0.1)] transition-all duration-300 ease-out w-max">
          Get in Touch
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 h-12 px-6 md:h-14 md:px-8 rounded-full bg-transparent border-2 border-white/20 text-white text-sm font-black tracking-tight hover:border-white hover:bg-white/5 hover:-translate-y-1 transition-all duration-300 ease-out w-max">
          Resume
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
          </svg>
        </a>
      </div>
    </header>

    <!-- Symmetrical Bento Grid (2 Columns Mobile/Tablet, 3 Columns Desktop) -->
    <div class="grid grid-cols-2 lg:grid-cols-3 gap-6 pb-20">
      <!-- Card 1 -->
      <div class="scroll-reveal">
        <VideoCard 
          href="/work/last-crumb"
          title="Last Crumb"
          subtitle="Social Media & Content Manager"
          category="Cookie Company"
          videoSrc="/videos/last-crumb.mp4"
          thumbnailSrc="/videos/last-crumb-poster.jpg"
          year="2026 – Present"
        />
      </div>
      
      <!-- Card 2 -->
      <div class="scroll-reveal delay-150">
        <VideoCard 
          href="/work/smore"
          title="S'more"
          category="Social Media App"
          subtitle="Social Media Specialist"
          embedSrc="https://www.youtube.com/embed/1wgp3HKYdaE"
          thumbnailPosition="top"
          year="2023 – 2025"
        />
      </div>

      <!-- Card 3 -->
      <div class="scroll-reveal delay-300">
        <VideoCard 
          href="/work/pixa"
          title="Pixa"
          category="AI Editing Software"
          subtitle="Paid Ad Content Creator"
          embedSrc="https://www.youtube.com/embed/rHPseq-qFuY"
          year="2025 – 2026"
        />
      </div>

      <!-- Card 4 -->
      <div class="scroll-reveal delay-150">
        <VideoCard 
          href="/work/nyu"
          title="NYU"
          category="University Relations and Public Affairs"
          subtitle="Social Media Assistant"
          embedSrc="https://www.youtube.com/embed/VWwaRpyOM44"
          year="2022 – 2023"
        />
      </div>

      <!-- Card 5 -->
      <div class="scroll-reveal delay-300">
        <VideoCard 
          href="/work/evanisboreddd"
          title="evanisbored"
          category="Personal Brand"
          subtitle="Creator"
          embedSrc="https://www.youtube.com/embed/ZLdSlGC8e7s"
          thumbnailPosition="center"
          year="2026 – Present"
        />
      </div>

      <!-- Card 6 -->
      <div class="scroll-reveal delay-450">
        <VideoCard 
          href="/work/kazuo"
          title="kazuo.gif"
          category="Personal Brand"
          subtitle="Creator"
          videoSrc="/videos/kazuo.mp4"
          thumbnailSrc="/videos/kazuo-poster.jpg"
          year="2026 – Present"
        />
      </div>
    </div>
  </main>
</Layout>