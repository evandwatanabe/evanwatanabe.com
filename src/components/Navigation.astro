---
const pathname = Astro.url.pathname;
---

<nav 
  id="global-nav"
  class="w-full px-8 md:px-16 py-6 flex items-center justify-between font-sans font-black tracking-tight bg-black md:bg-black/60 md:backdrop-blur-lg border-b border-white/5" 
  style="position: fixed !important; top: 0 !important; left: 0 !important; right: 0 !important; z-index: 100000 !important; pointer-events: auto !important; width: 100vw !important;"
>
  <!-- Logo -->
  <a href="/" class="text-sm text-white hover:text-white/80 transition-colors relative z-[100001]" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
    Evan Watanabe
  </a>

  <!-- Mobile Hamburger Button -->
  <button 
    id="menu-toggle"
    class="md:hidden relative z-[100001] flex flex-col gap-1.5 w-8 h-8 items-end justify-center group focus:outline-none"
    aria-label="Toggle Menu"
  >
    <span class="w-8 h-0.5 bg-white transition-all duration-300 origin-right group-[.is-active]:rotate-[-45deg] group-[.is-active]:-translate-y-[1px]"></span>
    <span class="w-6 h-0.5 bg-white transition-all duration-300 group-[.is-active]:opacity-0"></span>
    <span class="w-8 h-0.5 bg-white transition-all duration-300 origin-right group-[.is-active]:rotate-[45deg] group-[.is-active]:translate-y-[1px]"></span>
  </button>

  <!-- Desktop Menu -->
  <ul class="hidden md:flex gap-12 text-sm" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
    <li>
      <a href="/" class={`transition-colors ${pathname === '/' ? 'text-white font-black' : 'text-white/40 hover:text-white'}`}>
        Work
      </a>
    </li>
    <li>
      <a href="/about" class={`transition-colors ${pathname === '/about' ? 'text-white font-black' : 'text-white/40 hover:text-white'}`}>
        About
      </a>
    </li>
    <li>
      <a href="/contact" class={`transition-colors ${pathname === '/contact' ? 'text-white font-black' : 'text-white/40 hover:text-white'}`}>
        Contact
      </a>
    </li>
  </ul>

  <!-- Mobile Menu Overlay -->
  <div 
    id="mobile-menu"
    class="fixed inset-0 bg-black/95 backdrop-blur-xl z-[100000] flex flex-col items-center justify-center translate-x-full transition-transform duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] md:hidden"
  >
    <ul class="flex flex-col items-center gap-10 text-3xl font-black tracking-widest text-center" style="font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;">
      <li>
        <a href="/" class={`transition-colors ${pathname === '/' ? 'text-white' : 'text-white/20'}`}>Work</a>
      </li>
      <li>
        <a href="/about" class={`transition-colors ${pathname === '/about' ? 'text-white' : 'text-white/20'}`}>About</a>
      </li>
      <li>
        <a href="/contact" class={`transition-colors ${pathname === '/contact' ? 'text-white' : 'text-white/20'}`}>Contact</a>
      </li>
    </ul>
  </div>
</nav>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const isActive = toggle.classList.toggle('is-active');
      menu.classList.toggle('translate-x-full', !isActive);
      menu.classList.toggle('translate-x-0', isActive);
      
      // Prevent scrolling when menu is open
      document.body.style.overflow = isActive ? 'hidden' : '';
    });

    // Close menu when clicking a link
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        toggle.classList.remove('is-active');
        menu.classList.add('translate-x-full');
        menu.classList.remove('translate-x-0');
        document.body.style.overflow = '';
      });
    });
  }
</script>
